rue ,\n        startDelay:  0 ,\n        breakLines:  true ,\n        waitUntilVisible:  true ,\n        loop:  false ,\n        cursor: false,\n        html: true\n      }).go();\n      \n    });\n\u003c/script\u003e\n\u003ch2 id=\"engagement-associatif\"\u003eEngagement associatif\u003c/h2\u003e\n\u003cp\u003eHamadoun apporte son expertise technique à l\u0026rsquo;association Leidimen en assurant la maintenance des services web, la sécurité des données et le déploiement des outils collaboratifs utilisés par les bénévoles.\u003c/p\u003e","title":"Hamadoun Dicko","url":"https://hdicko.github.io/leidimen/equipe/hd/"},{"date":"2006-10-05T15:45:33+01:00","summary":"\u003cimg\n    src=\"images/aissa-logo.jpg\"\n    class=\"figure-img img-fluid rounded\"\n    alt=\"\"\n    loading=\"lazy\" /\u003e\n\n\n\u003cdetails\u003e\n  \u003csummary\u003eA propos de moi\u003c/summary\u003e\n  \u003cdiv class=\"details-content\"\u003e\n    \u003ch1 id=\"typeit-3da5e8c0604a10a233848313fa98c6cf\"\u003e\u003c/h1\u003e\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/typeit@8.7.1/dist/index.umd.js\"\u003e\u003c/script\u003e\n\u003cscript\u003e\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      \n      new TypeIt(\"#typeit-3da5e8c0604a10a233848313fa98c6cf\", {\n        strings: \"Dicko Aissa\",\n        speed:  100 ,\n        lifeLike:  true ,\n        startDelay:  0 ,\n        breakLines:  true ,\n        waitUntilVisible:  true ,\n        loop:  false ,\n        cursor: false,\n        html: true\n      }).go();\n      \n    });\n\u003c/script\u003e\n\u003ch2 id=\"présidente-de-leidimen\"\u003ePrésidente de Leidimen\u003c/h2\u003e\n\u003cp\u003eAissa Dicko est la présidente et membre fondatrice de l\u0026rsquo;association Leidimen. Passionnée par les valeurs de solidarité et d\u0026rsquo;entraide, elle coordonne l\u0026rsquo;ensemble des projets de l\u0026rsquo;association, notamment les initiatives éducatives au Mali.\u003c/p\u003e","title":"Aissa Dicko","url":"https://hdicko.github.io/leidimen/equipe/aissa/"},{"date":"2019-11-05T15:45:53+01:00","summary":"\u003cimg\n    src=\"images/abdoulaye.dicko.jpg\"\n    class=\"figure-img img-fluid rounded\"\n    alt=\"\"\n    loading=\"lazy\" /\u003e\n\n\n\u003cdetails\u003e\n  \u003csummary\u003eVoir le detail\u003c/summary\u003e\n  \u003cdiv class=\"details-content\"\u003e\n    \u003ch1 id=\"typeit-ab45af4ef07022652afc2c2ec35e8bbc\"\u003e\u003c/h1\u003e\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/typeit@8.7.1/dist/index.umd.js\"\u003e\u003c/script\u003e\n\u003cscript\u003e\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      \n      new TypeIt(\"#typeit-ab45af4ef07022652afc2c2ec35e8bbc\", {\n        strings: \"Abdoulaye Dicko\",\n        speed:  100 ,\n        lifeLike:  true ,\n        startDelay:  0 ,\n        breakLines:  true ,\n        waitUntilVisible:  true ,\n        loop:  false ,\n        cursor: false,\n        html: true\n      }).go();\n      \n    });\n\u003c/script\u003e\n\u003ch2 id=\"abdoulaye-dicko---membre-fondateur-de-leidimen\"\u003eAbdoulaye Dicko - Membre fondateur de Leidimen\u003c/h2\u003e\n\u003cp\u003eAbdoulaye Dicko est membre fondateur de l\u0026rsquo;association Leidimen depuis 2007. Avec sa devise \u003cstrong\u003e\u0026ldquo;Création entrepreneuriale et Solidarité\u0026rdquo;\u003c/strong\u003e, il allie son expertise professionnelle en management à son engagement solidaire.\u003c/p\u003e","title":"Abdoulaye Dicko","url":"https://hdicko.github.io/leidimen/equipe/abdoulaye/"},{"date":"2006-10-05T15:45:05+01:00","summary":"\u003cimg\n    src=\"images/mamadou-logo.jpg\"\n    class=\"figure-img img-fluid rounded\"\n    alt=\"\"\n    loading=\"lazy\" /\u003e\n\n\n\u003cdetails\u003e\n  \u003csummary\u003eEngagements\u003c/summary\u003e\n  \u003cdiv class=\"details-content\"\u003e\n    \u003ch2 id=\"mamadou-dicko---membre-fondateur-de-leidimen\"\u003eMamadou Dicko - Membre fondateur de Leidimen\u003c/h2\u003e\n\u003cp\u003eMamadou Dicko est membre fondateur et membre du conseil d\u0026rsquo;administration de l\u0026rsquo;association Leidimen depuis 2019. Son engagement est guidé par une conviction profonde : \u003cstrong\u003e\u0026ldquo;L\u0026rsquo;ÉCOLOGIE : UNE URGENCE VITALE, UNE CHANCE HISTORIQUE !\u0026rdquo;\u003c/strong\u003e\u003c/p\u003e\n\u003ch3 id=\"engagement-écologique\"\u003eEngagement écologique\u003c/h3\u003e\n\u003cp\u003eFervent défenseur de l\u0026rsquo;écologie et du développement durable, Mamadou œuvre pour intégrer ces valeurs dans tous les projets de l\u0026rsquo;association. Il sensibilise la communauté aux enjeux environnementaux et promeut des pratiques éco-responsables.\u003c/p\u003e","title":"Mamadou Dicko","url":"https://hdicko.github.io/leidimen/equipe/mamadou/"},{"date":"2006-01-03T00:00:00Z","summary":"\u003cdetails\u003e\n  \u003csummary\u003eA propos de moi\u003c/summary\u003e\n  \u003cdiv class=\"details-content\"\u003e\n    \u003ch1 id=\"typeit-9c8c79bc460a685d87abe4adc41c1b3e\"\u003e\u003c/h1\u003e\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/typeit@8.7.1/dist/index.umd.js\"\u003e\u003c/script\u003e\n\u003cscript\u003e\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      \n      new TypeIt(\"#typeit-9c8c79bc460a685d87abe4adc41c1b3e\", {\n        strings: \"Marc Dicko\",\n        speed:  100 ,\n        lifeLike:  true ,\n        startDelay:  0 ,\n        breakLines:  true ,\n        waitUntilVisible:  true ,\n        loop:  false ,\n        cursor: false,\n        html: true\n      }).go();\n      \n    });\n\u003c/script\u003e\n\u003ch2 id=\"membre-fondateur-de-leidimen\"\u003eMembre fondateur de Leidimen\u003c/h2\u003e\n\u003cp\u003eJe suis membre fondateur de l\u0026rsquo;association Leidimen. Passionnée par les valeurs de solidarité et d\u0026rsquo;entraide, je suis partie prenante de tous les projets de l\u0026rsquo;association, notamment les initiatives éducatives au Mali.\u003c/p\u003e","title":"Marc Dicko","url":"https://hdicko.github.io/leidimen/equipe/marc-dicko/"},{"date":"2025-08-19T10:00:00Z","summary":"\u003ch2 id=\"présentation\"\u003ePrésentation\n    \u003ca href=\"#pr%c3%a9sentation\"\u003e¶\u003c/a\u003e\n\u003c/h2\u003e\u003cp\u003eMariam Dicko est un membre dévoué du Conseil d\u0026rsquo;Administration de l\u0026rsquo;Association Leidimen depuis 2020. Forte de son expérience dans l\u0026rsquo;enseignement et sa maîtrise parfaite de l\u0026rsquo;anglais, elle apporte une perspective internationale précieuse aux projets de développement de l\u0026rsquo;association au Mali.\u003c/p\u003e\n\u003ch3 id=\"parcours-professionnel\"\u003eParcours professionnel\n    \u003ca href=\"#parcours-professionnel\"\u003e¶\u003c/a\u003e\n\u003c/h3\u003e\u003cp\u003eDiplômée en Sciences de l\u0026rsquo;Éducation de l\u0026rsquo;Université de Paris, Mariam a consacré sa carrière à l\u0026rsquo;enseignement de l\u0026rsquo;anglais dans le secondaire. Elle a également participé à plusieurs programmes d\u0026rsquo;échange éducatif entre la France et l\u0026rsquo;Afrique de l\u0026rsquo;Ouest, ce qui lui a donné une compréhension approfondie des défis éducatifs dans la région.\u003c/p\u003e","title":"Mariam Dicko","url":"https://hdicko.github.io/leidimen/equipe/mariam-dicko/"}],"title":"CA","url":"https://hdicko.github.io/leidimen/categories/ca/"}