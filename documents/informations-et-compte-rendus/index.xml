 &lt;a href="#rapports-annuels-de-lassociation"&gt;¶&lt;/a&gt;
&lt;/h2&gt;&lt;p&gt;Consultez nos rapports d&amp;rsquo;activités et comptes rendus annuels pour suivre l&amp;rsquo;évolution de nos actions au Mali.&lt;/p&gt;
&lt;style&gt;
 .rapport-card {
 transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
 border-radius: 16px;
 overflow: hidden;
 position: relative;
 }
 
 .rapport-card::before {
 content: '';
 position: absolute;
 top: 0;
 left: 0;
 right: 0;
 height: 4px;
 background: linear-gradient(90deg, #0d6efd 0%, #0dcaf0 100%);
 transform: scaleX(0);
 transition: transform 0.3s ease;
 }
 
 .rapport-card:hover {
 transform: translateY(-8px);
 box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15) !important;
 }
 
 .rapport-card:hover::before {
 transform: scaleX(1);
 }
 
 .rapport-card .card-icon {
 transition: all 0.3s ease;
 display: inline-block;
 }
 
 .rapport-card:hover .card-icon {
 transform: scale(1.1) rotate(5deg);
 }
 
 .rapport-card .btn {
 transition: all 0.3s ease;
 }
 
 .rapport-card:hover .btn {
 transform: scale(1.05);
 }
 
 .year-badge {
 position: absolute;
 top: 15px;
 right: 15px;
 background: rgba(13, 110, 253, 0.1);
 color: #0d6efd;
 padding: 4px 12px;
 border-radius: 20px;
 font-size: 0.85rem;
 font-weight: 600;
 }
 
 .rapport-nouveau {
 animation: pulse 2s infinite;
 box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4);
 }
 
 @keyframes pulse {
 0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4); }
 70% { box-shadow: 0 0 0 10px rgba(13, 110, 253, 0); }
 100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
 }
&lt;/style&gt;
