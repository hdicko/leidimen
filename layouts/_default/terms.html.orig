{{ define "main" }}
<hr class="border border-danger border-1 opacity-50" />
<p class="fs-2 text-center badge text-bg-info">_default/terms.html</p>
<hr class="border border-danger border-2 opacity-50" />

{{ $data := .Data }}
<div class="container-flex mt-3" role="main">
  <div
    class="col-lg-8 mx-auto col-md-10 offset-md-1 border border-success border-5 rounded-5"
  >
    <article class="post-preview">
      <div class="accordion" id="accordion">
        {{ range $key, $value := .Data.Terms.ByCount }}
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingOne">
            <button
              class="accordion-button collapsed"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#collapse{{ $value.Name }}"
            >
              <h4 class="accordion-header ms-2">
                {{ $value.Name }}
                <span
                  class="badge rounded-pill text-bg-light position-absolute text-end"
                  >{{ $value.Count }}</span
                >
              </h4>
            </button>
          </h2>
          <div
            id="collapse{{ $value.Name }}"
            class="accordion-collapse collapse"
          >
            <div class="accordion-body">
              <a
                href="{{ $.Site.LanguagePrefix | absURL }}/{{ $data.Plural }}/{{ $value.Name | urlize }}/"
                class="post-title list-group-item view-all text-center text-danger"
                >Voir quelques images / videos et info relatives au village : {{ $value.Name }}</a
              >
              <div class="list-group">
                {{ range $item := $value.WeightedPages }}
                <a href="{{$item.Permalink}}" class="list-group-item text-bg-info"
                  >{{ $item.Title }}</a
                >
                {{ end }}
              </div>
            </div>
          </div>
        </div>
        {{ end }}
      </div>
    </article>
  </div>
</div>

{{/**

<!-- listing and counting categories  -->
<p class="fs-2 text-center">Order Terms by count</p>
<div class="display text-center">
  <ul class="list-group list-group-horizontal">
    {{ $data := .Data }} {{ range $key, $value := .Data.Terms.ByCount }}
    <li class="list-group-item flex-fill border border-0">
      <a href="/{{ $data.Plural }}/{{ $value.Name | urlize }}"
        >{{ $value.Name | title }}</a
      >
    </li>
    {{ end }}
  </ul>
</div>

<hr class="border border-danger mx-3 opacity-50" />
<p class="fs-2 text-center">Order Alphabetically Terms</p>
<ul class="list-group list-group-horizontal">
  {{ range .Data.Terms.Alphabetical }}
  <li class="list-group-item flex-fill border border-0">
    <a
      class="list-group-item list-group-item-action list-group-item-light"
      href="{{ .Page.Permalink }}"
      >{{ .Page.Title }}</a
    >
    {{ .Count }}
  </li>
  {{ end }}
</ul>
**/}} {{/** card terms
<hr class="border border-danger mx-3 opacity-50" />
<p class="fs-2 text-center">Cards Terms</p>
<hr class="border border-danger mx-3 opacity-50" />
<p class="fs-2 text-center">Terms</p>
<div class="col-xxl-8 col-xxl-12">
  <div class="container">
    <div class="">
      {{- range .Paginator.Pages -}} {{- $count := len .Pages -}}
      <div class="row card">
        <div class="card-header">
          {{- if eq .Data.Plural "moods" }}
          <div
            class="author d-flex mt-2 flex-column flex-md-row align-items-center"
          >
            <div class="text-center text-md-start flex-grow-1 ms-0 ms-md-4">
              <h2
                class="taxonomy-title card-title author-name fs-4 mb-2 text-surface"
              >
                <a href="{{ .Page.RelPermalink }}">{{ .Page.Title }}</a>
              </h2>
              {{- with .Page.Description }}
              <div class="author-description mb-2">{{ . }}</div>
              {{- end }}
            </div>
          </div>
          {{- else }}
          <h2 class="card-title fs-4 my-2">
            <a href="{{ .Page.RelPermalink }}">{{ .Page.Title }}</a>
          </h2>
          {{- end }}
        </div>
        <div class="card-body">
          <div class="mt-1 mb-3">
            <span class=""
              ><i class="fas fa-fw fa-file-alt me-1"></i>{{ i18n "post_count"
              (dict "Count" $count) }}</span
            >
          </div>
          {{- $postCount := $.Site.Params.taxonomyPostCount -}} {{- if
          $postCount -}}
          <ul class="list-unstyled ms-1">
            {{- range first $postCount .Pages -}}
            <li class="taxonomy-post mb-2">
              <a class="post-title" href="{{ .RelPermalink }}">{{ .Title }}</a>
              <span class="float-end post-date"
                >{{ .Date | time.Format $.Site.Params.dateFormat }}</span
              >
            </li>
            {{- end -}}
          </ul>
          {{- end -}}
        </div>
        {{- if gt $count $postCount -}}
        <div class="card-footer">
          <a
            class="btn btn-sm btn-outline-primary"
            href="{{ .Page.RelPermalink }}"
            >{{ i18n "read_more" }}</a
          >
        </div>
        {{- end -}}
      </div>
      {{- end -}}
    </div>
  </div>
</div>

**/}} {{ end }} {{/* end main */}}
